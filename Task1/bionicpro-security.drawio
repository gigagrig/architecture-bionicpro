source="auth" target="memory"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.65;entryX=1;entryY=0.5;" edge="1" parent="1" source="auth" target="profile"><mxGeometry as="geometry" relative="1"><Array><mxPoint x="1280" y="320" /><mxPoint x="1280" y="670" /></Array></mxGeometry></mxCell><mxCell id="e6" value="Code + verifier → токены;&lt;br/&gt;обновление refresh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.85;" edge="1" parent="1" source="auth" target="kc"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1410" y="310" /><mxPoint x="1410" y="950" /><mxPoint x="790" y="950" /></Array></mxGeometry></mxCell><mxCell id="e7" value="SQL / учётные данные" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="kc" target="kcdb"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" value="LDAPS / проверка пароля, группы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="kc" target="ldap"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="790" y="1160" /><mxPoint x="1635" y="1160" /></Array></mxGeometry></mxCell><mxCell id="e9" value="OAuth 2.0 / broker" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="kc" target="yandex"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="790" y="940" /><mxPoint x="1450" y="940" /><mxPoint x="1450" y="830" /></Array></mxGeometry></mxCell><mxCell id="e10" value="После согласия: профиль / HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.3;" edge="1" parent="1" source="auth" target="yandex"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1370" y="310" /><mxPoint x="1370" y="760" /><mxPoint x="1640" y="760" /></Array></mxGeometry></mxCell><mxCell id="e11" value="API:&lt;br/&gt;серверный&lt;br/&gt;токен" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;exitX=0;exitY=0.8;" edge="1" parent="1" source="auth" target="api"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="940" y="310" /><mxPoint x="940" y="580" /><mxPoint x="790" y="580" /></Array></mxGeometry></mxCell><mxCell id="e12" value="Донастройка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="mobile" target="chip"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="280" y="490" /><mxPoint x="280" y="670" /></Array></mxGeometry></mxCell><mxCell id="e13" value="Использует" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="pilot" target="mobile"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="130" y="490" /></Array></mxGeometry></mxCell><mxCell id="e14" value="4G / техническая телеметрия" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="chip" target="api"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="460" y="750" /><mxPoint x="620" y="750" /><mxPoint x="620" y="670" /></Array></mxGeometry></mxCell><mxCell id="e15" value="Запись / чтение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="api" target="data"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e16" value="Заказ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="buyer" target="store"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e17" value="Продажи" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="store" target="crm"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e18" value="SQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="crm" target="crmdb"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e19" value="Аналитика в регионе" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="ml" target="data"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1510" y="930" /><mxPoint x="940" y="930" /><mxPoint x="940" y="860" /></Array></mxGeometry></mxCell><mxCell id="e20" value="Целевая интеграция входа" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;dashed=1;" edge="1" parent="1" source="mobile" target="gateway"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="610" y="490" /><mxPoint x="610" y="380" /><mxPoint x="790" y="380" /></Array></mxGeometry></mxCell><mxCell id="legend" value="Зелёный — новые / изменённые контейнеры; синий — исходные; пунктирная стрелка — целевая интеграция, не реализованная в задании 1.&lt;br/&gt;Внешний IdP и LDAP находятся в стране соответствующего развёртывания. Браузер проходит страницу входа Keycloak через шлюз.&lt;br/&gt;Память сессий — часть процесса bionicpro-auth, показана отдельно для объяснения хранения. Для нативных приложений требуется отдельная адаптация входа." style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="1220" width="1460" height="90" /></mxCell><mxCell id="operator" value="&lt;b&gt;Оператор производства&lt;/b&gt;&lt;br/&gt;[Человек]" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#334c6b;strokeColor=#334c6b;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="1000" width="235" height="90" /></mxCell><mxCell id="e21" value="Работа с клиентами" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="operator" target="crm"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="Локализация" name="Локализация"><mxGraphModel dx="1600" dy="940" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1600" pageHeight="940"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t" value="&lt;b&gt;BionicPRO · региональные контуры доверия&lt;/b&gt;&lt;br/&gt;Одинаковый контракт сессий; независимое хранение идентификационных и медицинских данных" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="110" y="20" width="1380" height="80" /></mxCell><mxCell id="ru" value="Россия" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=none;strokeColor=#708090;dashed=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=10;arcSize=3;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="150" width="700" height="650" /></mxCell><mxCell id="other" value="Другая страна · повторяемый контур" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=none;strokeColor=#708090;dashed=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=10;arcSize=3;" vertex="1" parent="1"><mxGeometry as="geometry" x="850" y="150" width="700" height="650" /></mxCell><mxCell id="rui" value="&lt;b&gt;Региональный адрес&lt;/b&gt;&lt;br/&gt;UI → Nginx → bionicpro-auth" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="95" y="220" width="300" height="95" /></mxCell><mxCell id="rkc" value="&lt;b&gt;Региональный Keycloak&lt;/b&gt;&lt;br/&gt;OTP, единые роли BionicPRO" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="220" width="285" height="95" /></mxCell><mxCell id="ridp" value="&lt;b&gt;Местный источник учётных записей&lt;/b&gt;&lt;br/&gt;LDAP или IdP по OIDC / SAML / OAuth" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="430" width="285" height="120" /></mxCell><mxCell id="rdb" value="&lt;b&gt;Региональные хранилища&lt;/b&gt;&lt;br/&gt;Сессии, профили, Keycloak DB&lt;br/&gt;CRM, медицинские данные, телеметрия" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="95" y="600" width="570" height="120" /></mxCell><mxCell id="re1" value="PKCE S256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="rui" target="rkc"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="re2" value="Аутентификация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="rkc" target="ridp"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="re3" value="Сессии / профили" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="rui" target="rdb"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="250" y="490" /></Array></mxGeometry></mxCell><mxCell id="re4" value="Учётные данные" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="rkc" target="rdb"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="720" y="380" /><mxPoint x="720" y="570" /><mxPoint x="600" y="570" /></Array></mxGeometry></mxCell><mxCell id="fui" value="&lt;b&gt;Региональный адрес&lt;/b&gt;&lt;br/&gt;UI → Nginx → bionicpro-auth" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="895" y="220" width="300" height="95" /></mxCell><mxCell id="fkc" value="&lt;b&gt;Региональный Keycloak&lt;/b&gt;&lt;br/&gt;OTP, единые роли BionicPRO" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="220" width="285" height="95" /></mxCell><mxCell id="fidp" value="&lt;b&gt;Местный источник учётных записей&lt;/b&gt;&lt;br/&gt;LDAP или IdP по OIDC / SAML / OAuth" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="430" width="285" height="120" /></mxCell><mxCell id="fdb" value="&lt;b&gt;Региональные хранилища&lt;/b&gt;&lt;br/&gt;Сессии, профили, Keycloak DB&lt;br/&gt;CRM, медицинские данные, телеметрия" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="895" y="600" width="570" height="120" /></mxCell><mxCell id="fe1" value="PKCE S256" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="fui" target="fkc"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="fe2" value="Аутентификация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="fkc" target="fidp"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="fe3" value="Сессии / профили" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="fui" target="fdb"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1050" y="490" /></Array></mxGeometry></mxCell><mxCell id="fe4" value="Учётные данные" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;labelBackgroundColor=#ffffff;endArrow=block;" edge="1" parent="1" source="fkc" target="fdb"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1520" y="380" /><mxPoint x="1520" y="570" /><mxPoint x="1400" y="570" /></Array></mxGeometry></mxCell><mxCell id="n" value="Нет соединения между региональными БД. В другой стране пользователь выбирает адрес местного представительства.&lt;br/&gt;Регион учётной записи назначается при регистрации; смена URL не переносит данные. Глобальный каталог пользователей не создаётся.&lt;br/&gt;Между регионами допустимо распространять версии ПО и шаблоны ролей без персональных данных.&lt;br/&gt;Конкретная страна, провайдер, сроки хранения и правила трансграничного доступа требуют согласования до запуска." style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="90" y="820" width="1420" height="95" /></mxCell></root></mxGraphModel></diagram></mxfile>
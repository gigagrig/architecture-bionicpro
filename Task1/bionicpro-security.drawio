<mxfile host="app.diagrams.net" agent="BionicPRO" version="26.0.0"><diagram id="C4 — контейнеры" name="C4 — контейнеры"><mxGraphModel dx="1800" dy="1320" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1320"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b&gt;BionicPRO · управление доступом&lt;/b&gt;&lt;br/&gt;C4: контейнеры одного регионального развёртывания" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=0;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="10" width="1180" height="65" /></mxCell><mxCell id="boundary" value="BionicPRO · страна обслуживания пользователя&lt;br/&gt;Все хранилища, логи, резервные копии и ключи остаются в этом регионе" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=none;strokeColor=#708090;dashed=1;verticalAlign=top;align=left;spacingTop=10;spacingLeft=10;arcSize=3;" vertex="1" parent="1"><mxGeometry as="geometry" x="300" y="100" width="1170" height="1110" /></mxCell><mxCell id="pilot" value="&lt;b&gt;Пилот протеза&lt;/b&gt;&lt;br/&gt;[Человек]" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#334c6b;strokeColor=#334c6b;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry as="geometry" x="20" y="290" width="220" height="80" /></mxCell><mxCell id="web" value="&lt;b&gt;Личный кабинет&lt;/b&gt;&lt;br/&gt;[React]&lt;br/&gt;Только cookie сессии" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="350" y="260" width="230" height="90" /></mxCell><mxCell id="gateway" value="&lt;b&gt;HTTPS-шлюз&lt;/b&gt;&lt;br/&gt;[Nginx]&lt;br/&gt;Единый origin, TLS" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="260" width="230" height="90" /></mxCell><mxCell id="auth" value="&lt;b&gt;bionicpro-auth&lt;/b&gt;&lt;br/&gt;[Python / FastAPI]&lt;br/&gt;PKCE, сессии, согласие" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="260" width="230" height="90" /></mxCell><mxCell id="memory" value="&lt;b&gt;Хранилище сессий&lt;/b&gt;&lt;br/&gt;[Память bionicpro-auth]&lt;br/&gt;Access + шифрованный refresh" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="440" width="260" height="100" /></mxCell><mxCell id="profile" value="&lt;b&gt;Профили и согласия&lt;/b&gt;&lt;br/&gt;[PostgreSQL]&lt;br/&gt;Шифрование полей профиля" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="620" width="260" height="100" /></mxCell><mxCell id="kc" value="&lt;b&gt;Региональный Keycloak&lt;/b&gt;&lt;br/&gt;[Java, IdP / broker]&lt;br/&gt;Вход, OTP, роли" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="1000" width="260" height="100" /></mxCell><mxCell id="kcdb" value="&lt;b&gt;Учётные данные&lt;/b&gt;&lt;br/&gt;[PostgreSQL]&lt;br/&gt;OTP, связи с IdP, роли" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="1000" width="260" height="100" /></mxCell><mxCell id="ldap" value="&lt;b&gt;Каталог представительства&lt;/b&gt;&lt;br/&gt;[OpenLDAP, внешний источник]&lt;br/&gt;Пароли и группы этого региона" style="html=1;whiteSpace=wrap;fontSize=15;spacing=8;rounded=1;fillColor=#daf0e8;strokeColor=#1c7860;" vertex="1" parent="1"><mxGeometry as="geometry" x="1510" y="1000" width="265" height="100" /></mxCell><mxCell id="yandex" value="&lt;b&gt;Локальный